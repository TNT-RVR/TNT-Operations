# ─────────────────────────────────────────────────────────────────────────────
# TNT Operations — environment template.
# Copy this file to `.env` and fill in values. NEVER commit the real `.env`.
#
# NEW DEVELOPERS: you do NOT need any secrets to start. Leave everything below
# as-is (VITE_DATA_SOURCE=mock) and run `npm run dev` — the app runs fully on
# seeded in-browser data with no backend.
# ─────────────────────────────────────────────────────────────────────────────

# Which data backend the app talks to: `mock` (localStorage, no backend) or
# `supabase` (live Postgres backend). Default to mock for local development.
VITE_DATA_SOURCE=mock

# ── Supabase (only needed when VITE_DATA_SOURCE=supabase) ────────────────────
# Get these from the Supabase dashboard → Project Settings → API.
# The anon key is safe to expose in the browser (public). Do NOT put the
# service_role key here — it belongs only in server/Edge Function secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── MapLibre basemap (optional) ──────────────────────────────────────────────
# Leave blank to use the free OpenStreetMap raster basemap (dev default).
# For satellite imagery in production, set a MapTiler (or similar) key.
VITE_MAP_TILE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# The following are SERVER-SIDE ONLY secrets. They do NOT belong in this file
# and must never be prefixed with VITE_ (that would ship them to the browser).
# They live in Supabase Edge Function / Netlify env settings instead:
#   - GOVEE_API_KEY          (sensor polling)
#   - SUPABASE_SERVICE_ROLE  (server writes / import scripts)
#   - SMTP_* or RESEND_API_KEY (email reports)
# See docs/darren-onboarding.md.
# ─────────────────────────────────────────────────────────────────────────────
